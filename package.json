{
	"name": "compare-pdf",
	"version": "3.1.0",
	"description": "Standalone node module that compares PDF's",
	"type": "module",
	"exports": {
		"types": "./types/ComparePdf.d.ts",
		"default": "./functions/ComparePdf.js"
	},
	"types": "./types/ComparePdf.d.ts",
	"scripts": {
		"genTypes": "tsc",
		"lint": "eslint . --fix",
		"pretty": "npx prettier --write .",
		"test": "mocha --recursive --timeout 25000",
		"pre-commit": "npx lint-staged",
		"prepare": "node .husky/install.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marcdacz/compare-pdf.git"
	},
	"engines": {
		"node": ">=26.13.0"
	},
	"homepage": "https://github.com/marcdacz/compare-pdf#readme",
	"keywords": ["pdf", "graphicsMagick", "imageMagick", "compare pdf", "test pdf"],
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/format": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@eslint/markdown": "^8.0.3",
		"@prettier/plugin-xml": "^3.4.2",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.6",
		"chai": "^6.3.0",
		"chai-files": "^1.4.0",
		"conventional-changelog-angular": "^9.4.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"mocha": "12.0.3",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.1.1",
		"cross-spawn": "^7.0.6",
		"pdfjs-dist": "6.5.438",
		"pixelmatch": "^8.0.0",
		"pngjs": "^7.0.0"
	},
	"lint-staged": {
		"**/*": ["eslint --cache --fix", "prettier --write --ignore-unknown"]
	}
